# AI 自动化博客系统环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============ LLM 配置（文本生成） ============
# 支持的提供商: openai, claude
# openai 兼容格式适用于: OpenAI、DeepSeek、Groq、Grok2API、Ollama、Azure OpenAI 等
# claude 格式适用于: Anthropic Claude 系列

# LLM 提供商（必须）: openai 或 claude
LLM_PROVIDER=openai

# --- OpenAI 兼容格式配置 ---
# API 地址（必须），根据服务商不同设置：
#   OpenAI:      https://api.openai.com/v1/chat/completions
#   DeepSeek:    https://api.deepseek.com/v1/chat/completions
#   Groq:        https://api.groq.com/openai/v1/chat/completions
#   Grok2API:    https://grok2api-4u83.onrender.com/v1/chat/completions
#   Ollama:      http://localhost:11434/v1/chat/completions
#   Azure:       https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-15-preview
LLM_API_URL=https://api.openai.com/v1/chat/completions

# API 密钥（必须）
LLM_API_KEY=your_llm_api_key_here

# 模型名称（必须），根据服务商不同设置：
#   OpenAI:    gpt-4o, gpt-4o-mini, gpt-4-turbo
#   DeepSeek:  deepseek-chat, deepseek-reasoner
#   Groq:      llama-3.3-70b-versatile, mixtral-8x7b-32768
#   Grok2API:  grok-2
#   Ollama:    llama3, qwen2, mistral 等（本地模型名）
LLM_MODEL=gpt-4o

# 生成温度（可选，默认: 0.7）
LLM_TEMPERATURE=0.7

# 最大输出 token 数（可选，默认: 4096）
LLM_MAX_TOKENS=4096

# Top-P 采样参数（可选，默认: 1.0）
LLM_TOP_P=1.0   

# --- Claude 格式配置 ---
# API 地址（使用 Claude 提供商时必须）
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# API 密钥（使用 Claude 提供商时必须）
CLAUDE_API_KEY=your_claude_api_key_here

# 模型名称（可选，默认: claude-sonnet-4-20250514）
# 可选: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
CLAUDE_MODEL=claude-sonnet-4-20250514

# 最大输出 token 数（可选，默认: 4096）
CLAUDE_MAX_TOKENS=4096

# 生成温度（可选，默认: 0.7）
CLAUDE_TEMPERATURE=0.7

# ============ 图片生成模型配置 ============
# 支持的提供商: pollinations, openai, stability, replicate, custom
#   pollinations: 免费，无需 API Key
#   openai:       OpenAI DALL-E 2/3 及兼容 API
#   stability:    Stability AI
#   replicate:    Replicate 平台模型
#   custom:       自定义 OpenAI 兼容格式 API

IMAGE_PROVIDER=pollinations

# --- Pollinations.ai 配置（免费） ---
POLLINATIONS_API_URL=https://image.pollinations.ai/prompt/
POLLINATIONS_WIDTH=1024
POLLINATIONS_HEIGHT=576

# --- OpenAI DALL-E 格式配置 ---
# API 地址（可选，默认: OpenAI 官方）
IMAGE_API_URL=https://api.openai.com/v1/images/generations

# API 密钥（使用 openai 提供商时必须）
IMAGE_API_KEY=your_openai_image_api_key_here

# 模型名称（可选，默认: dall-e-3）
# 可选: dall-e-2, dall-e-3
IMAGE_MODEL=dall-e-3

# 图片尺寸（可选，默认: 1024x1024）
# DALL-E 3 支持: 1024x1024, 1024x1792, 1792x1024
# DALL-E 2 支持: 256x256, 512x512, 1024x1024
IMAGE_SIZE=1024x1024

# 图片质量（可选，默认: standard）
# DALL-E 3 支持: standard, hd
IMAGE_QUALITY=standard

# 生成数量（可选，默认: 1）
IMAGE_N=1

# --- Stability AI 格式配置 ---
STABILITY_API_URL=https://api.stability.ai/v2beta/image/generate
STABILITY_API_KEY=your_stability_api_key_here
STABILITY_MODEL=stable-diffusion-xl
STABILITY_WIDTH=1024
STABILITY_HEIGHT=576

# --- Replicate 格式配置 ---
REPLICATE_API_URL=https://api.replicate.com/v1/predictions
REPLICATE_API_KEY=your_replicate_api_key_here
REPLICATE_MODEL=stability-ai/sdxl

# --- 自定义图片生成 API（OpenAI 兼容格式） ---
CUSTOM_IMAGE_API_URL=
CUSTOM_IMAGE_API_KEY=
CUSTOM_IMAGE_MODEL=

# ============ 向后兼容（旧配置自动映射） ============
# 如果仍使用旧的 GROK_* 配置，系统会自动映射到新的 LLM_* 配置
# GROK_API_URL=https://grok2api-4u83.onrender.com/v1/chat/completions
# GROK_API_KEY=your_grok_api_key_here
# GROK_MODEL=grok-2

# ============ Notion 配置 ============
# Notion Integration Token（必须）
# 获取地址: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 数据库 ID（必须）
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ 图床配置 ============
# 图床上传地址（可选，默认使用 tc.741568.xyz）
IMAGE_UPLOAD_URL=https://tc.741568.xyz/upload

# 图床授权码（可选，默认: 1024）
IMAGE_AUTH_CODE=1024

# ============ 文章生成配置 ============
# 文章最小字数（可选，默认: 2000）
ARTICLE_MIN_LENGTH=2000

# 封面图片风格描述（可选）
COVER_IMAGE_STYLE=科技风格，深色背景，现代感，无文字，简约设计，高品质，专业感

# ============ 系统配置 ============
# Notion API 批量写入块数（可选，默认: 100）
BATCH_SIZE=100

# 临时文件目录（可选，默认: temp）
TEMP_DIR=temp

# 图片临时存储目录（可选，默认: temp/images）
IMAGES_DIR=temp/images
